<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>771abbd5-5c18-4352-84cb-5e86fc245a60</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.4" />
	  <PackageReference Include="Aspire.Hosting.Seq" Version="13.6.4" />
	  <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
	  <!-- Microsoft.Data.SqlClient (via Aspire / EF Core SqlServer) brings System.Security.Cryptography.Pkcs 10.0.12:
	       CVE-2026-84008 (fixed in 10.0.13). Remove once SqlClient brings a fixed version. -->
	  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	  <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.1" />
	  <PackageReference Include="KubernetesClient" Version="19.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeMonitoring.MigrationService\HomeMonitoring.MigrationService.csproj" />
    <ProjectReference Include="..\HomeMonitoring.SensorAgent\HomeMonitoring.SensorAgent.csproj" />
    <ProjectReference Include="..\HomeMonitoring.Web\HomeMonitoring.Web.csproj" />
  </ItemGroup>

</Project>
